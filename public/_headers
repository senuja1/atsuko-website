/*
  # Enforce TLS / HTTPS Strict Transport Security (HSTS) with subdomains and preload (2 years)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Prevent MIME-type sniffing / confusion attacks
  X-Content-Type-Options: nosniff

  # Prevent Clickjacking & UI Redressing
  X-Frame-Options: SAMEORIGIN

  # Legacy XSS Filter for older browsers
  X-XSS-Protection: 1; mode=block

  # Protect Referrer leakage across origins
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable unneeded powerful device hardware APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Comprehensive Content Security Policy (CSP)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' data: https: blob:; connect-src 'self' https://wa.me https://api.whatsapp.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com;
